# Plantilla de entorno. Copiala a `.env` y rellena los valores:
#     cp env.example .env
#
# `.env` esta en .gitignore y NUNCA se commitea.
#
# Nota: el fichero se llama `env.example` y no `.env.example` porque la
# configuracion global de Claude Code deniega la escritura sobre `.env.*`.
# Es una proteccion deliberada y se respeta.

# ── Postgres (servicio `db` de docker compose) ───────────────────────────────
POSTGRES_USER=finapp
POSTGRES_DB=finapp
# Genera una cadena aleatoria. No reutilices contrasenas de otros entornos.
POSTGRES_PASSWORD=RELLENAR
# Publicado solo en loopback (127.0.0.1) para lanzar migraciones desde el host.
# No es 5432 porque esta maquina ya tiene un PostgreSQL propio ocupando ese
# puerto. Dentro de la red de compose la BD sigue siendo `db:5432`.
POSTGRES_PORT=55432

# ── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# El host es `db`, el nombre del servicio en compose. No `localhost`.
DATABASE_URL=postgresql://finapp:RELLENAR@db:5432/finapp
# Origen exacto del frontend para CORS. Nunca `*`.
ORIGEN_FRONTEND=http://localhost:5173

# ── Web ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1
