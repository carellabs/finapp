{
  "name": "@finapp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "migrate:up": "node-pg-migrate -m migraciones up",
    "migrate:down": "node-pg-migrate -m migraciones down",
    "migrate:redo": "node-pg-migrate -m migraciones down 0 && node-pg-migrate -m migraciones up",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "crear-usuario": "tsx scripts/crear-usuario.ts"
  },
  "dependencies": {
    "@finapp/shared": "^0.1.0",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "fast-check": "^4.10.2",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
